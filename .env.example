# T Rock CRM environment template
# Use placeholders only. Never commit real secrets or production credentials.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# OPTIONAL
NODE_ENV=development
# OPTIONAL
PORT=3001
# OPTIONAL
TRUST_PROXY=false
# DEV-ONLY
DEV_MODE=false
# DEV-ONLY
ALLOW_DEV_AUTH_IN_PROD=false
# DEV-ONLY
VITEST=false

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# REQUIRED
DATABASE_URL=postgresql://user:password@host:5432/trock_crm
# OPTIONAL
DB_POOL_MAX=20
# BOOTSTRAP-ONLY
DATABASE_PUBLIC_URL=postgresql://user:password@host:5432/trock_crm

# ---------------------------------------------------------------------------
# Auth, Sessions, And Encryption
# ---------------------------------------------------------------------------
# REQUIRED
JWT_SECRET=xxxxxxxx
# REQUIRED
ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPTIONAL
AZURE_CLIENT_ID=xxxxxxxx
# OPTIONAL
AZURE_CLIENT_SECRET=xxxxxxxx
# OPTIONAL
AZURE_TENANT_ID=common
# DEV-ONLY
DEMO_DEFAULT_OFFICE_SLUG=dallas
# DEV-ONLY
ENABLE_AUTH_DEMO_BOOTSTRAP=false

# ---------------------------------------------------------------------------
# Public URLs And Origins
# ---------------------------------------------------------------------------
# REQUIRED
FRONTEND_URL=https://crm.example.com
# REQUIRED
API_BASE_URL=https://api.example.com
# OPTIONAL
API_URL=https://api.example.com
# OPTIONAL
CORS_ALLOWED_ORIGINS=https://crm.example.com,https://field.example.com
# OPTIONAL
# Production HTTPS frontend origins allowed to receive SameSite=None auth cookies
# and response-body CSRF tokens for fallback cross-site auth flows.
STRICT_CROSS_SITE_AUTH_ORIGINS=https://crm.example.com
# OPTIONAL
CSP_CONNECT_SRC=https://api.example.com
# OPTIONAL
RAILWAY_PUBLIC_DOMAIN=api.example.com
# OPTIONAL
RAILWAY_STATIC_URL=https://api.example.com
# OPTIONAL
RAILWAY_SERVICE_FRONTEND_URL=https://crm.example.com

# ---------------------------------------------------------------------------
# Field App
# ---------------------------------------------------------------------------
# OPTIONAL
FIELD_APP_URL=https://field.example.com
# OPTIONAL
FIELD_FRONTEND_URL=https://field.example.com
# OPTIONAL
RAILWAY_SERVICE_FIELD_FRONTEND_URL=https://field.example.com

# ---------------------------------------------------------------------------
# Procore
# ---------------------------------------------------------------------------
# OPTIONAL
PROCORE_CLIENT_ID=xxxxxxxx
# OPTIONAL
PROCORE_CLIENT_SECRET=xxxxxxxx
# OPTIONAL
PROCORE_COMPANY_ID=xxxxxxxx
# OPTIONAL
PROCORE_WEBHOOK_SECRET=xxxxxxxx
# OPTIONAL
PROCORE_PHOTOS_PUSH_ENABLED=false
# OPTIONAL
PROCORE_LINK_CREATION_ENABLED=false

# ---------------------------------------------------------------------------
# HubSpot And Legacy Migration
# ---------------------------------------------------------------------------
# OPTIONAL
HUBSPOT_PRIVATE_APP_TOKEN=xxxxxxxx
# BOOTSTRAP-ONLY
DRY_RUN=true
# BOOTSTRAP-ONLY
REFRESH_COMPANY_ID=false
# BOOTSTRAP-ONLY
TENANT_SCHEMA=office_example
# BOOTSTRAP-ONLY
OFFICE_SLUG=dallas
# BOOTSTRAP-ONLY
LIMIT=100
# BOOTSTRAP-ONLY
AUTO_MERGE=false
# BOOTSTRAP-ONLY
VERBOSE=false

# ---------------------------------------------------------------------------
# SyncHub / Internal Relay
# ---------------------------------------------------------------------------
# OPTIONAL
SYNCHUB_BASE_URL=https://synchub.example.com
# OPTIONAL
SYNC_HUB_BASE_URL=https://synchub.example.com
# OPTIONAL
SYNCHUB_URL=https://synchub.example.com
# OPTIONAL
SYNCHUB_INTEGRATION_SECRET=xxxxxxxx
# OPTIONAL
SYNCHUB_RELAY_SECRET=xxxxxxxx
# OPTIONAL
SYNCHUB_SHARED_SECRET=xxxxxxxx
# OPTIONAL
SYNCHUB_RELAY_RECEIVER_ENABLED=true
# OPTIONAL
# Procore company id to CRM office schema/slug mapping for SyncHub stage-change relay tenant resolution.
# Format can be comma-separated key=value pairs or a JSON object. Defaults include 598134325683880=office_dallas.
PROCORE_COMPANY_OFFICE_MAP=598134325683880=office_dallas
# BOOTSTRAP-ONLY
SYNCHUB_DATABASE_URL=postgresql://user:password@host:5432/synchub
# OPTIONAL
BID_BOARD_SYNC_SECRET=xxxxxxxx

# ---------------------------------------------------------------------------
# AI / Copilot
# ---------------------------------------------------------------------------
# OPTIONAL
AI_COPILOT_PROVIDER=heuristic
# OPTIONAL
OPENAI_API_KEY=xxxxxxxx
# OPTIONAL
OPENAI_MODEL=gpt-5.4-mini
# OPTIONAL
AI_COPILOT_OPENAI_MODEL=gpt-5.4-mini
# OPTIONAL
ANTHROPIC_API_KEY=xxxxxxxx
# OPTIONAL
AI_COPILOT_ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPTIONAL
ALLOW_LEGACY_OUTCOME_WRITES=false
# DEV-ONLY
POLICY_RECOMMENDATION_FIXTURE_OFFICE_IDS=
# DEV-ONLY
POLICY_RECOMMENDATION_FIXTURE_ACTOR_EMAIL=admin@example.com
# DEV-ONLY
POLICY_RECOMMENDATION_FIXTURE_SEED_KEY=local-fixture

# ---------------------------------------------------------------------------
# CompanyCam And Geocoding
# ---------------------------------------------------------------------------
# OPTIONAL
COMPANYCAM_API_KEY=xxxxxxxx
# OPTIONAL
GOOGLE_GEOCODING_API_KEY=xxxxxxxx

# ---------------------------------------------------------------------------
# Email / Notifications
# ---------------------------------------------------------------------------
# OPTIONAL
RESEND_API_KEY=xxxxxxxx
# OPTIONAL
RESEND_FROM_ADDRESS=crm@example.com
# OPTIONAL
EMAIL_OVERRIDE_RECIPIENT=
# REQUIRED IN PROD (worker service) — recipient of the "project number assigned" notification.
# If unset in production the worker logs an ERROR and the job retries a few times, then dead-letters
# per the job queue's max_attempts (NO silent fallback to a dev address). In development/test only,
# it defaults to a hardcoded dev address.
CHRISTY_PROJECT_NUMBER_EMAIL=
# RECOMMENDED IN PROD (worker service) — CC copy of the project-number notification. If unset in
# production the worker logs an ERROR and still sends to the primary recipient without the CC.
PROJECT_NUMBER_EMAIL_CC=
# OPTIONAL
SYSTEM_NOTIFICATION_EMAIL_OVERRIDE_ADDRESS=
# OPTIONAL
COMPANY_VERIFICATION_EMAIL=

# ---------------------------------------------------------------------------
# Storage / Cloudflare R2
# ---------------------------------------------------------------------------
# OPTIONAL
R2_ACCOUNT_ID=xxxxxxxx
# OPTIONAL
R2_ACCESS_KEY_ID=xxxxxxxx
# OPTIONAL
R2_SECRET_ACCESS_KEY=xxxxxxxx
# OPTIONAL
R2_BUCKET_NAME=trock-crm-files
# OPTIONAL
R2_ALLOWED_ORIGINS=https://crm.example.com,https://field.example.com
# OPTIONAL
R2_CSP_DOMAIN=

# ---------------------------------------------------------------------------
# Worker And Call Recording
# ---------------------------------------------------------------------------
# OPTIONAL
WORKER_HEALTH_PORT=3002
# OPTIONAL
CALL_RECORDING_TRANSCRIPTION_INTERVAL_MS=60000
# OPTIONAL
CALL_RECORDING_TRANSCRIPTION_DAILY_CAP_USD=50

# ---------------------------------------------------------------------------
# Feature Flags
# ---------------------------------------------------------------------------
# OPTIONAL
ENABLE_LEAD_EDIT_V2=false
# OPTIONAL
ENABLE_OPPORTUNITY_RFP_EVENT=false
# OPTIONAL
ENABLE_CONTRACT_SIGNED_HANDOFF=true
# OPTIONAL
ENABLE_CONTRACT_STAGE_SELECTION=true
# OPTIONAL
PROPOSAL_DRAFTING_ENABLED=false

# ---------------------------------------------------------------------------
# T Rock AI Demo (separate Railway service: `npm run start:ai-demo` from server)
# ---------------------------------------------------------------------------
# Password-gated AI demo over read-only Dallas CRM data via a scoped MCP server.
# These are consumed ONLY by the dist/mcp/index.js entrypoint, not the CRM API.
# REQUIRED — single shared page-gate password for the demo (POST /api/login).
DEMO_PASSWORD=xxxxxxxx
# REQUIRED — dedicated secret signing the scoped MCP session token + demo session
# cookie. MUST be different from JWT_SECRET (separate token families).
MCP_SESSION_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# REQUIRED — Anthropic API key for the /api/ai-chat connector (Messages API).
ANTHROPIC_API_KEY=xxxxxxxx
# REQUIRED — same Postgres as the CRM (the demo reads office_dallas read-only).
# Reuses DATABASE_URL above; listed here for the separate service's env checklist.
# REQUIRED — this demo service's own public HTTPS origin. Used to build the MCP
# connector URL (<PUBLIC_BASE_URL>/mcp) handed to Anthropic; must be https://.
PUBLIC_BASE_URL=https://trock-ai-demo.example.com
