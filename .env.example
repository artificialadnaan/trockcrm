# ---------------------------------------------------------------------------
# SyncHub / Internal Relay
# ---------------------------------------------------------------------------
# OPTIONAL
SYNCHUB_BASE_URL=https://synchub.example.com
# OPTIONAL
SYNC_HUB_BASE_URL=https://synchub.example.com
# OPTIONAL
SYNCHUB_URL=https://synchub.example.com
# OPTIONAL
SYNCHUB_INTEGRATION_SECRET=xxxxxxxx
# OPTIONAL
SYNCHUB_RELAY_SECRET=xxxxxxxx
# OPTIONAL
SYNCHUB_SHARED_SECRET=xxxxxxxx
# OPTIONAL
SYNCHUB_RELAY_RECEIVER_ENABLED=true
# OPTIONAL
# Procore company id to CRM office schema/slug mapping for SyncHub stage-change relay tenant resolution.
# Format can be comma-separated key=value pairs or a JSON object. Defaults include 598134325683880=office_dallas.
PROCORE_COMPANY_OFFICE_MAP=598134325683880=office_dallas
# BOOTSTRAP-ONLY
SYNCHUB_DATABASE_URL=postgresql://user:password@host:5432/synchub
# OPTIONAL
BID_BOARD_SYNC_SECRET=xxxxxxxx

# ---------------------------------------------------------------------------
# TROCK Scope (glasses-walkthrough scope-extraction service)
# ---------------------------------------------------------------------------
# REQUIRED for the glasses_walkthrough_forward worker job. trockcrm presents this as a bearer token —
# TROCK Scope does not yet have matching machine-auth middleware (see the follow-up noted on
# worker/src/jobs/glasses-walkthrough-forward.ts).
TROCK_SCOPE_BASE_URL=https://scope.example.com
TROCK_SCOPE_SERVICE_TOKEN=xxxxxxxx
# REQUIRED for the INBOUND direction — the shared secret TROCK Scope signs its export with, and the one
# `POST /api/integrations/scope/walkthrough-extractions` verifies. The two above are how trockcrm calls
# Scope; this is how Scope calls back, and they are different credentials in opposite directions.
#
# WITHOUT IT THE ENDPOINT REFUSES EVERYTHING, deliberately: `verifySignature` returns false when the
# secret is absent, because a missing environment variable must never be the thing that opens a write
# endpoint on the estimating pipeline. That is the right failure, but it is indistinguishable from a
# wrong signature by design (both answer a bare 401), so an operator who has not been told this
# variable exists has no way to diagnose it from the response. Hence: documented here.
#
# HMAC-SHA256 over the EXACT request bytes, sent as `x-trock-scope-signature: sha256=<hex>`. Provision
# the SAME value on both sides. The body must not be compressed — the signature covers what was
# transmitted, and the receiver refuses `Content-Encoding` for that reason.
TROCK_SCOPE_INGEST_SECRET=xxxxxxxx
# RECOMMENDED IN PROD (worker service) — comma-separated recipients for the one-time email alert sent
# when a glasses_walkthrough_forward job dead-letters (config error OR exhausted retries): the walk is
# filed, but no TROCK Scope was ever generated from it. If unset in production the sweep logs an ERROR
# and retries every cycle (never silently drops the alert). In development/test only, it defaults to a
# hardcoded dev address.
GLASSES_WALKTHROUGH_FORWARD_EMAIL_RECIPIENTS=

# ---------------------------------------------------------------------------
# Report Access Allowlists
# ---------------------------------------------------------------------------
# Reports whose readership is a NAMED LIST of addresses rather than a role, because the surface is
# privacy- or performance-sensitive and a role check would widen it to every future holder of that role.
# Every list here FAILS CLOSED: unset or blank in production means nobody may open the report, and its
# card disappears from the report index. That is deliberate — falling back to a role check would restore
# exactly the access the list exists to withhold.
#
# REQUIRED IN PROD (api service) — comma-separated addresses allowed to open the Daily Activity Log
# (/reports/performance/daily-activity-log). It shows the CONTENT of what people logged, including synced
# email bodies for admin/director. Note this only NARROWS: the ordinary admin/director/rep role floor and
# the report's own per-rep row scoping both still apply underneath it.
DAILY_ACTIVITY_LOG_VIEWER_EMAILS=
# DEV-ONLY — the address the dev/test fallback treats as a viewer. Without it an unconfigured local
# environment denies everyone, because the built-in fallback is a placeholder nobody owns.
DEV_DAILY_ACTIVITY_LOG_VIEWER=

# REQUIRED IN PROD (api service) — comma-separated addresses allowed to open the Canvassing Activity
# report (/reports/performance/canvassing-activity). It is a per-person scoreboard of how much new
# business each individual entered, so it is limited to the leaders accountable for that push rather
# than to everyone holding a role. The ordinary admin/director/rep role floor still applies underneath.
CANVASSING_REPORT_VIEWER_EMAILS=
# DEV-ONLY — as above, for this report.
DEV_CANVASSING_REPORT_VIEWER=

# ---------------------------------------------------------------------------
# Destructive-Action Allowlists
# ---------------------------------------------------------------------------
# REQUIRED IN PROD (api service) — comma-separated addresses allowed to move a deal back to Opportunity.
#
# That one action severs the deal from Bid Board sync, retires its RFP cycle, and VOIDS any booked
# commission — none of which is undone by moving the deal forward again. Every admin and director can make
# ordinary backward stage moves; this one destroys money, so it is a named list rather than a role.
#
# FAILS CLOSED: unset or blank means nobody can perform it and the menu item is hidden. Because the action
# is new, that means it is simply unavailable rather than something being taken away — no other path
# through the deal changes. In development/test only, falls back to DEV_DEAL_MOVE_BACK_APPROVER or a
# non-deliverable placeholder.
DEAL_MOVE_BACK_APPROVER_EMAILS=
# DEV-ONLY — the address the dev/test fallback treats as an approver.
DEV_DEAL_MOVE_BACK_APPROVER=

# ---------------------------------------------------------------------------
# AI / Copilot
# ---------------------------------------------------------------------------
# OPTIONAL
AI_COPILOT_PROVIDER=heuristic
# OPTIONAL
OPENAI_API_KEY=xxxxxxxx
# OPTIONAL
OPENAI_MODEL=gpt-5.4-mini
# OPTIONAL
AI_COPILOT_OPENAI_MODEL=gpt-5.4-mini
# OPTIONAL
ANTHROPIC_API_KEY=xxxxxxxx
# OPTIONAL
AI_COPILOT_ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPTIONAL
ALLOW_LEGACY_OUTCOME_WRITES=false
# DEV-ONLY
POLICY_RECOMMENDATION_FIXTURE_OFFICE_IDS=
# DEV-ONLY
POLICY_RECOMMENDATION_FIXTURE_ACTOR_EMAIL=admin@example.com
# DEV-ONLY
POLICY_RECOMMENDATION_FIXTURE_SEED_KEY=local-fixture

# ---------------------------------------------------------------------------
# CompanyCam And Geocoding
# ---------------------------------------------------------------------------
# OPTIONAL
COMPANYCAM_API_KEY=xxxxxxxx
# OPTIONAL
GOOGLE_GEOCODING_API_KEY=xxxxxxxx

# ---------------------------------------------------------------------------
# Email / Notifications
# ---------------------------------------------------------------------------
# OPTIONAL
RESEND_API_KEY=xxxxxxxx
# OPTIONAL
RESEND_FROM_ADDRESS=crm@example.com
# REQUIRED IN PROD (API service) — the signing secret Resend shows when you create the webhook endpoint,
# `whsec_...`. It authenticates POST /api/webhooks/resend, which is the ONLY thing that ever learns a
# weekly report bounced: without it that endpoint FAILS CLOSED and rejects every event, so a client whose
# address is mistyped goes on reading as delivered forever and nobody is told. Not needed on the worker,
# which sends mail and receives nothing.
RESEND_WEBHOOK_SECRET=

# REQUIRED ON THE PRODUCTION WORKER SERVICE, AND THERE ONLY. `weekly_report_send` is the only job whose
# recipients come from a CUSTOMER contact table rather than from staff, so it REFUSES TO SEND unless the
# deployment running it says here, explicitly, that it may email real clients. Set it to `true` on the
# production worker; leave it unset everywhere else. Anything other than `true` (unset, blank, `false`)
# refuses, and the refusal is recorded on the report as `send_error` and surfaced on the dashboard.
#
# Do NOT clone a production worker's variables into another service: this flag travels with a bulk copy
# exactly as RESEND_API_KEY does, and no env var can defend against that. It is set per service.
#
# It replaced a NODE_ENV check that could not do this job at all: Dockerfile.worker hardcodes
# `ENV NODE_ENV=production` in its runtime stage, so that value is a property of the IMAGE and reads
# `production` on the production worker, on a staging worker running the same image against a restored
# production dump, and on `node worker/dist/index.js` locally.
WEEKLY_REPORT_CLIENT_EMAIL_ENABLED=
# OPTIONAL — redirects EVERY system email to this one address instead of its real recipients.
# It also stands the `weekly_report_send` guard above aside, because it redirects every recipient to one
# internal mailbox before the provider is called: there is no client left to protect. This is how a
# staging or local worker exercises the real send path without WEEKLY_REPORT_CLIENT_EMAIL_ENABLED.
EMAIL_OVERRIDE_RECIPIENT=
# REQUIRED IN PROD (worker service) — recipient of the "project number assigned" notification.
# If unset in production the worker logs an ERROR and the job retries a few times, then dead-letters
# per the job queue's max_attempts (NO silent fallback to a dev address). In development/test only,
# it defaults to a hardcoded dev address.
CHRISTY_PROJECT_NUMBER_EMAIL=
# RECOMMENDED IN PROD (worker service) — CC copy of the project-number notification. If unset in
# production the worker logs an ERROR and still sends to the primary recipient without the CC.
PROJECT_NUMBER_EMAIL_CC=
# OPTIONAL
SYSTEM_NOTIFICATION_EMAIL_OVERRIDE_ADDRESS=
# OPTIONAL
COMPANY_VERIFICATION_EMAIL=

# ---------------------------------------------------------------------------
# Storage / Cloudflare R2
# ---------------------------------------------------------------------------
# OPTIONAL
R2_ACCOUNT_ID=xxxxxxxx
# OPTIONAL
R2_ACCESS_KEY_ID=xxxxxxxx
# OPTIONAL
R2_SECRET_ACCESS_KEY=xxxxxxxx
# OPTIONAL
R2_BUCKET_NAME=trock-crm-files
# OPTIONAL
R2_ALLOWED_ORIGINS=https://crm.example.com,https://field.example.com
# OPTIONAL
R2_CSP_DOMAIN=

# ---------------------------------------------------------------------------
# Worker And Call Recording
# ---------------------------------------------------------------------------
# OPTIONAL
WORKER_HEALTH_PORT=3002
# OPTIONAL
CALL_RECORDING_TRANSCRIPTION_INTERVAL_MS=60000
# OPTIONAL
CALL_RECORDING_TRANSCRIPTION_DAILY_CAP_USD=50

# ---------------------------------------------------------------------------
# Feature Flags
# ---------------------------------------------------------------------------
# OPTIONAL
ENABLE_LEAD_EDIT_V2=false
# OPTIONAL
ENABLE_OPPORTUNITY_RFP_EVENT=false
# OPTIONAL
ENABLE_CONTRACT_SIGNED_HANDOFF=true
# OPTIONAL
ENABLE_CONTRACT_STAGE_SELECTION=true
# OPTIONAL
PROPOSAL_DRAFTING_ENABLED=false

# ---------------------------------------------------------------------------
# Mobile Build (T-Rock Cam / mobile) — read at PREBUILD time, not at runtime
# ---------------------------------------------------------------------------
# These are consumed by mobile/app.config.ts and passed to the withWearablesDat config plugin.
# They are NOT EXPO_PUBLIC_* and never reach the JS bundle; they only shape the generated ios/
# project, so changing one requires a rebuild, not a reload.
#
# REQUIRED IN PROD (mobile) — Meta Wearables Developer Center app id. When unset, the plugin falls
# back to MetaAppID "0", the SDK's Developer Mode sentinel: the app runs against MockDeviceKit with
# no registered app, so no real pair of glasses is ever eligible and every walkthrough fails at
# pairing. A production EAS build (EAS_BUILD_PROFILE=production) FAILS PREBUILD rather than ship
# that; every other profile keeps the "0" default.
META_APP_ID=
# OPTIONAL (mobile) — client token from the same Wearables Developer Center app. Omitted entirely
# from the MWDAT Info.plist dict when unset.
META_CLIENT_TOKEN=
# OPTIONAL (mobile) — Apple Developer team id written into DEVELOPMENT_TEAM. `expo prebuild` does
# not carry it over from eas.json, and without it device signing fails and MWDAT.TeamID (written as
# $(DEVELOPMENT_TEAM)) resolves to an empty string. Defaults to the T Rock team in app.config.ts.
APPLE_TEAM_ID=
