PROPOSAL_DRAFTING_ENABLED=false
# OPTIONAL (worker service) — lets the weekly-report reminder emails lead with the T-Rock Cam deep link
# (`trockcam://reports`) instead of the CRM board. Most recipients are `construction` /
# `field_contractor` accounts that /projects/weekly-reports refuses outright, so the app link is the only
# destination that works for them. Parsed as `=== "true"` after trim+lowercase: "1" and "yes" are FALSE,
# it must be literally `true`.
#
# ⚠️ THE PRECONDITION IS A PROPERTY OF THE INSTALLED APP, NOT OF THIS REPO. The deny-list that decides
# what a tapped trockcam:// link does is the one compiled into the T-Rock Cam build ON THE PHONE.
# `"reports"` entered APP_OWN_ROUTES (mobile/src/wearables/pairing-callback.ts) and the reports route
# entered mobile/app/(app)/ in the SAME commit, #1073, and `mobile/` has NO OTA — no expo-updates
# dependency, no `updates`/`runtimeVersion` in app.config.ts — so that change reaches devices only
# through a new EAS build, TestFlight, and a user installing it.
#
# On any build older than #1073, APP_OWN_ROUTES is {accept-invite, scorecards}. `routeKeyOf` returns
# "reports", the deny-list therefore treats the link as a possible Meta glasses pairing callback and
# RETAINS it — evicting a genuinely held one and leaving the glasses unpaired with no error surface —
# and expo-router lands the super on Unmatched Route. That is precisely the failure this flag exists to
# prevent, and it lasts for as long as any device stays un-updated, not until the next release.
#
# So: enable this only once the T-Rock Cam build in the field CONTAINS #1073. Default off until then.
WEEKLY_REPORT_APP_DEEP_LINKS=false

# ---------------------------------------------------------------------------
# Mobile Build (T-Rock Cam / mobile) — read at PREBUILD time, not at runtime
# ---------------------------------------------------------------------------
# These are consumed by mobile/app.config.ts and passed to the withWearablesDat config plugin.
# They are NOT EXPO_PUBLIC_* and never reach the JS bundle; they only shape the generated ios/
# project, so changing one requires a rebuild, not a reload.
#
# REQUIRED IN PROD (mobile) — Meta Wearables Developer Center app id. When unset, the plugin falls
# back to MetaAppID "0", the SDK's Developer Mode sentinel: the app runs against MockDeviceKit with
# no registered app, so no real pair of glasses is ever eligible and every walkthrough fails at
# pairing. A production EAS build (EAS_BUILD_PROFILE=production) FAILS PREBUILD rather than ship
# that; every other profile keeps the "0" default.
META_APP_ID=
# OPTIONAL (mobile) — client token from the same Wearables Developer Center app. Omitted entirely
# from the MWDAT Info.plist dict when unset.
META_CLIENT_TOKEN=
# OPTIONAL (mobile) — Apple Developer team id written into DEVELOPMENT_TEAM. `expo prebuild` does
# not carry it over from eas.json, and without it device signing fails and MWDAT.TeamID (written as
# $(DEVELOPMENT_TEAM)) resolves to an empty string. Defaults to the T Rock team in app.config.ts.
APPLE_TEAM_ID=
