+  /// conversion to the capture device's normalized point-of-interest space.
+  @MainActor
+  func focusAtPoint(x: Double, y: Double) async -> Bool {
+    guard x.isFinite, y.isFinite, bounds.width > 0, bounds.height > 0 else {
+      return false
+    }
+
+    let viewPoint = CGPoint(
+      x: min(max(CGFloat(x), bounds.minX), bounds.maxX),
+      y: min(max(CGFloat(y), bounds.minY), bounds.maxY)
+    )
