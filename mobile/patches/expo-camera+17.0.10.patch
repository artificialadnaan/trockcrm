+  /// Applies continuous AF and AE metering at a normalized capture-device point.
+  /// Returns false for fixed-focus cameras so callers can avoid displaying a
+  /// misleading success reticle.
+  func focus(at point: CGPoint) async -> Bool {
+    guard let delegate else {
+      return false
+    }
+
+    return await withCheckedContinuation { continuation in
+      delegate.sessionQueue.async { [weak self] in
+        guard let self,
+              let device = self.captureDeviceInput?.device,
+              device.isFocusPointOfInterestSupported,
+              device.isFocusModeSupported(.continuousAutoFocus) else {
+          continuation.resume(returning: false)
+          return
+        }
+
+        do {
+          try device.lockForConfiguration()
+          defer { device.unlockForConfiguration() }
+
+          device.focusPointOfInterest = point
+          device.focusMode = .continuousAutoFocus
+
+          if device.isExposurePointOfInterestSupported,
+             device.isExposureModeSupported(.continuousAutoExposure) {
+            device.exposurePointOfInterest = point
+            device.exposureMode = .continuousAutoExposure
+          }
+          continuation.resume(returning: true)
+        } catch {
+          log.info("\(#function): \(error.localizedDescription)")
+          continuation.resume(returning: false)
+        }
+      }
+    }
+  }
