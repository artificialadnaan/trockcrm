# T-Rock Cam — mobile env (Expo reads EXPO_PUBLIC_* at build time)

# Backend API base URL — REQUIRED (no trailing /api — the client appends it).
# Set this to the trockcrm field API host before building. Do NOT commit the
# real host (repo disclosure policy); provide it via EAS env or a local .env.
EXPO_PUBLIC_API_BASE_URL=https://<prod-api-host>

# Field web host for HTTPS universal-link invite onboarding (e.g. field.<domain>).
# Optional; emailed HTTPS invites open the native accept-invite route only when
# this is set AND the backend serves an apple-app-site-association file at the host.
# Without it the custom trockcam:// scheme still works (HTTPS invites fall back to web).
# EXPO_PUBLIC_FIELD_APP_HOST=field.<your-domain>

# EAS project id — already bound in app.config.ts; set this only to override.
# EAS_PROJECT_ID=d829c598-4767-40cf-ba32-2441bd406221
