# T-Rock Cam — mobile env (Expo reads EXPO_PUBLIC_* at build time)

# Backend API base URL — REQUIRED (no trailing /api — the client appends it).
# Set this to the trockcrm field API host before building. Do NOT commit the
# real host (repo disclosure policy); provide it via EAS env or a local .env.
EXPO_PUBLIC_API_BASE_URL=https://<prod-api-host>

# EAS project id (created by `eas init`). Optional locally; used by app.config.ts.
# EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
