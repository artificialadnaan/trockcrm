{
  "name": "@trock-crm/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b tsconfig.build.json --clean && tsc -b tsconfig.build.json --force",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "typecheck:tests": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:runtime": "vitest run runtime.test --passWithNoTests=false"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1022.0",
    "@azure/msal-node": "^3.3.0",
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@trock-crm/shared": "*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "exifr": "^7.1.3",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "resend": "^6.10.0"
  },
  "devDependencies": {
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2"
  }
}
