{
  "name": "@trock-crm/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/schema/index.js",
  "exports": {
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./utils": {
      "types": "./dist/utils/normalize.d.ts",
      "default": "./dist/utils/normalize.js"
    },
    "./lib/bidBoardStatusMap": {
      "types": "./dist/lib/bidBoardStatusMap.d.ts",
      "default": "./dist/lib/bidBoardStatusMap.js"
    },
    "./lib/rfpReviewerEmails": {
      "types": "./dist/lib/rfpReviewerEmails.d.ts",
      "default": "./dist/lib/rfpReviewerEmails.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json --clean && tsc -b tsconfig.build.json --force",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.json --noEmit",
    "test:ci": "vitest run --config vitest.ci.config.ts",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.4"
  }
}
