{
  "name": "@trock-crm/ai-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Demo-grade AI chat over T Rock CRM data, exposed to Anthropic via a scoped, read-only MCP server. Deployed as a SEPARATE Railway service from the same monorepo.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b tsconfig.build.json --clean && tsc -b tsconfig.build.json --force",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "typecheck:tests": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:runtime": "vitest run runtime.test --passWithNoTests=false"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
